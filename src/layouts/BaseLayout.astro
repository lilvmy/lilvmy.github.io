---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ViewTransitions } from "astro:transitions";

import { SITE_TITLE, SITE_DESCRIPTION, TRANSITION_API } from "../config";

const {
  image,
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  includeSidebar = true,
  sideBarActiveItemID,
  ogType,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="lofi">
  <head>
    <BaseHead title={title} description={description} image={image} ogType={ogType} />
    {TRANSITION_API && <ViewTransitions />}

    <style is:global>
      /* ================= 1. 全站配色变量（可随时修改色值） ================= */
      :root {
        /* 默认方案：典雅学术蓝（搭配柔和浅灰白背景，长时间阅读不刺眼） */
        --theme-primary: #1e40af;       /* 主色调（高亮文字、下划线、选中胶囊） */
        --theme-primary-light: #dbeafe; /* 浅色点缀（悬停背景、水波纹光晕） */
        --theme-bg: #f8fafc;            /* 网页整体背景色 */
        --theme-header: rgba(255, 255, 255, 0.88); /* 顶部导航栏毛玻璃背景 */

        /* 备选方案 A（墨韵翡翠绿）：将上面 4 行替换为下面 4 行即可 */
        /* --theme-primary: #065f46; --theme-primary-light: #d1fae5; --theme-bg: #f6faf8; --theme-header: rgba(255, 255, 255, 0.88); */

        /* 备选方案 B（书卷暖棕金）：适合人文/经典学术风格 */
        /* --theme-primary: #92400e; --theme-primary-light: #fef3c7; --theme-bg: #fcfaf7; --theme-header: rgba(252, 250, 247, 0.9); */

        /* 备选方案 C（雅致靛紫）：适合设计/前沿科研风格 */
        /* --theme-primary: #5b21b6; --theme-primary-light: #ede9fe; --theme-bg: #faf8ff; --theme-header: rgba(255, 255, 255, 0.88); */
      }

      /* ================= 2. 字体、间距与两端对齐 ================= */
      body {
        background-color: var(--theme-bg) !important;
        font-family: "Times New Roman", Times, "KaiTi", "楷体", "STKaiti", "Kaiti SC", serif;
      }

      main p,
      main text,
      main li {
        display: block;
        text-align: justify !important;
        text-justify: auto;
        hyphens: auto;
        -webkit-hyphens: auto;

        letter-spacing: 0.03em;
        word-spacing: 0.05em;
        line-height: 1.8;
        text-autospace: normal;
      }

      main li {
        display: list-item;
      }

      /* 段落之间自动空出一整行（与 1.8 倍行高保持一致） */
      main p {
        margin-bottom: 1.8em;
      }

      /* 最后一个段落底部不留多余空白 */
      main p:last-child {
        margin-bottom: 0;
      }

      /* ================= 3. 精细化内部下拉滚动条样式 ================= */
      .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
      }

      .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
      }

      .custom-scrollbar::-webkit-scrollbar-thumb {
        background-color: rgba(148, 163, 184, 0.45);
        border-radius: 999px;
      }

      .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background-color: var(--theme-primary);
      }

      /* ================= 4. 页面切换平滑上浮入场动画 ================= */
      @keyframes pageFadeSlideUp {
        from {
          opacity: 0;
          transform: translateY(14px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      main {
        animation: pageFadeSlideUp 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      /* ================= 5. 功能键悬停滑块与点击水波纹动效 ================= */
      .nav-dynamic-btn {
        position: relative;
        overflow: hidden;
        transition: color 0.25s ease, background-color 0.25s ease, transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
      }

      .nav-dynamic-btn:active {
        transform: scale(0.92);
      }

      .nav-underline::after {
        content: "";
        position: absolute;
        left: 20%;
        right: 20%;
        bottom: 4px;
        height: 2.5px;
        border-radius: 999px;
        background-color: var(--theme-primary);
        transform: scaleX(0);
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      }

      .nav-underline:hover::after,
      .nav-underline.is-active::after {
        transform: scaleX(1);
      }

      @keyframes rippleSpread {
        to {
          transform: scale(3.5);
          opacity: 0;
        }
      }

      .click-ripple {
        position: absolute;
        border-radius: 50%;
        background-color: var(--theme-primary);
        opacity: 0.28;
        pointer-events: none;
        transform: scale(0);
        animation: rippleSpread 0.55s ease-out forwards;
      }

      /* ================= 6. NEW 角标动态礼花与流光特效 ================= */
      .badge-new-celebrate {
        position: relative;
        background: linear-gradient(135deg, #ef4444, #f59e0b, #ec4899) !important;
        background-size: 200% 200% !important;
        color: #ffffff !important;
        border: none !important;
        font-weight: 700 !important;
        letter-spacing: 0.06em;
        cursor: pointer;
        box-shadow: 0 2px 10px rgba(239, 68, 68, 0.35);
        animation: newBadgeGlow 2.4s ease-in-out infinite;
        transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
      }

      .badge-new-celebrate:hover {
        transform: scale(1.14);
      }

      @keyframes newBadgeGlow {
        0%, 100% {
          background-position: 0% 50%;
          box-shadow: 0 2px 8px rgba(239, 68, 68, 0.35);
        }
        50% {
          background-position: 100% 50%;
          box-shadow: 0 0 14px rgba(245, 158, 11, 0.65);
        }
      }

      .confetti-particle {
        position: fixed;
        pointer-events: none;
        z-index: 9999;
        will-change: transform, opacity;
      }
    </style>
  </head>

  <body>
    <div class="min-h-screen flex flex-col">
      <Header title={SITE_TITLE} sideBarActiveItemID={sideBarActiveItemID} />
      <main class="flex-1 w-full max-w-[900px] mx-auto px-6 pt-10 pb-12">
        <slot />
      </main>
      <Footer />
    </div>

    <!-- 1. 点击功能键触发水波纹光圈脚本 -->
    <script is:inline>
      document.addEventListener("pointerdown", function (e) {
        const target = e.target.closest(".nav-dynamic-btn, .btn");
        if (!target) return;

        const rect = target.getBoundingClientRect();
        const size = Math.max(rect.width, rect.height);
        const ripple = document.createElement("span");
        ripple.className = "click-ripple";
        ripple.style.width = ripple.style.height = size + "px";
        ripple.style.left = e.clientX - rect.left - size / 2 + "px";
        ripple.style.top = e.clientY - rect.top - size / 2 + "px";

        target.appendChild(ripple);
        setTimeout(() => ripple.remove(), 600);
      });
    </script>

    <!-- 2. NEW 角标动态礼花脚本 -->
    <script is:inline>
      (function () {
        const COLORS = ["#ef4444", "#f59e0b", "#10b981", "#3b82f6", "#8b5cf6", "#ec4899"];

        function launchFirework(el) {
          if (!el || el.dataset.cooling === "1") return;
          const rect = el.getBoundingClientRect();
          if (rect.width === 0 || rect.height === 0) return;

          el.dataset.cooling = "1";
          setTimeout(() => {
            el.dataset.cooling = "0";
          }, 700);

          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;
          const particleCount = 28;

          for (let i = 0; i < particleCount; i++) {
            const p = document.createElement("span");
            p.className = "confetti-particle";

            const isCircle = i % 3 === 0;
            const size = 5 + Math.random() * 4;
            p.style.width = size + "px";
            p.style.height = (isCircle ? size : size * 0.55) + "px";
            p.style.borderRadius = isCircle ? "50%" : "2px";
            p.style.backgroundColor = COLORS[i % COLORS.length];
            p.style.left = cx + "px";
            p.style.top = cy + "px";
            document.body.appendChild(p);

            const angle = -Math.PI * (0.1 + Math.random() * 0.8);
            const distance = 45 + Math.random() * 75;
            const dx = Math.cos(angle) * distance + (Math.random() - 0.5) * 30;
            const dyPeak = Math.sin(angle) * distance - 18;
            const dyEnd = dyPeak + 45 + Math.random() * 35;
            const rotate = (Math.random() - 0.5) * 720;
            const duration = 750 + Math.random() * 450;

            const anim = p.animate(
              [
                { transform: "translate(-50%, -50%) scale(0.4) rotate(0deg)", opacity: 1 },
                { transform: `translate(${dx * 0.75}px, ${dyPeak}px) scale(1) rotate(${rotate * 0.6}deg)`, opacity: 1, offset: 0.45 },
                { transform: `translate(${dx}px, ${dyEnd}px) scale(0.75) rotate(${rotate}deg)`, opacity: 0 }
              ],
              { duration: duration, easing: "cubic-bezier(0.16, 1, 0.3, 1)" }
            );

            anim.onfinish = () => p.remove();
          }
        }

        function initNewBadges() {
          document.querySelectorAll(".badge").forEach((badge) => {
            if (badge.textContent.trim().toUpperCase() === "NEW") {
              badge.classList.add("badge-new-celebrate");
              badge.title = "点击或悬停放礼花";
              badge.addEventListener("mouseenter", () => launchFirework(badge));
              badge.addEventListener("click", (e) => {
                e.preventDefault();
                e.stopPropagation();
                launchFirework(badge);
              });
              setTimeout(() => launchFirework(badge), 450);
            }
          });
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initNewBadges);
        } else {
          initNewBadges();
        }
      })();
    </script>
  </body>
</html>
