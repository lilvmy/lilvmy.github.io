---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="科研 | Publications" sideBarActiveItemID="publications">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">学术论文</div>
  </div>

  <HorizontalCard
    title="论文标题示例（2026）"
    img="/post_img.webp"
    desc="作者列表 | 发表于 IEEE / ACM XX 期刊或会议"
    url="https://arxiv.org/"
    badge="CCF-A"
  />
  <div class="divider my-0"></div>
</BaseLayout>
