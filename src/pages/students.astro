---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="学生 | Students" sideBarActiveItemID="students">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">指导学生 / 团队成员</div>
  </div>

  <h2 class="text-xl font-bold mt-6 mb-3">在读研究生</h2>
  <ul class="list-disc pl-6 space-y-2 text-base">
    <li><strong>张三</strong>（2025级硕士）— 研究方向：人工智能与机器学习</li>
    <li><strong>李四</strong>（2026级硕士）— 研究方向：计算机视觉</li>
  </ul>

  <h2 class="text-xl font-bold mt-8 mb-3">毕业生</h2>
  <ul class="list-disc pl-6 space-y-2 text-base">
    <li><strong>王五</strong>（2025届硕士）— 毕业去向：XX 科技公司</li>
  </ul>
</BaseLayout>
