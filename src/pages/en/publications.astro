---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
---

<BaseLayout title="Publications | Your Name" sideBarActiveItemID="publications">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Publications</div>
  </div>

  <HorizontalCard
    title="Sample Paper Title: A Novel Approach to XX (2026)"
    img="/post_img.webp"
    desc="Author One, Author Two, Your Name | Published in IEEE / ACM Transactions or Conference"
    url="https://arxiv.org/"
    badge="CCF-A"
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="Second Paper Title: Exploring XX Systems (2025)"
    img="/post_img.webp"
    desc="Your Name, Co-author | Proceedings of XX International Conference"
    url="https://arxiv.org/"
  />
</BaseLayout>
