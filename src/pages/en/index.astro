---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";

// 按时间顺序排列：每次有新动态直接追加在数组【最后面】，网页会自动将其置顶并显示 NEW 与礼花
const newsList = [
  {
    title: "Our manuscript FSAT has been accepted by IEEE Transactions on Information Forensics and Security (CCF-A, JCR Q1, 2026 IF: 8.0).",
    img: "/FSAT.png",
    desc: "",
    url: "/news",
  },
  {
    title: "Our manuscript Mimi has been accepted by IEEE Transactions on Dependable and Secure Computing (CCF-A, JCR Q1, 2026 IF: 7.5).",
    img: "/Mimi.png",
    desc: "",
    url: "/news",
  },
];
---

<BaseLayout title="Dong Li | Personal Homepage" sideBarActiveItemID="home">
  <div class="pb-10 mt-4 flex flex-col md:flex-row items-center md:items-start gap-8">
    <!-- Profile Photo -->
    <div class="shrink-0">
      <img
        src="/ld.jpg"
        alt="Dong Li"
        class="w-36 h-36 md:w-44 md:h-44 rounded-full object-cover shadow-md border border-base-200"
      />
    </div>

    <!-- Bio, Education, Overseas Experience, Employment & Links -->
    <div class="flex-1 text-center md:text-left">
      <div class="text-xl py-1">Hello 👋</div>
      <div class="text-4xl font-bold">Dong Li</div>
      <div class="text-xl py-2 text-slate-600 font-medium">
        College of Cyber Security, Jinan University / Qinglan Scholar
      </div>

      <div class="py-2 text-base leading-relaxed">
        <p>
          I am currently a Faculty Member and a Qinglan Scholar at the College of Cyber Security, Jinan University. I received my Ph.D. in Engineering from Chongqing University in 2026 under the supervision of Prof. Xiaofeng Liao (Fellow of IEEE/AAIA/AIIA, Changjiang Distinguished Professor, and Director of the Key Laboratory of Dependable Service Computing in Cyber Physical Society, Ministry of Education). Previously, I was a Visiting Scholar at Nanyang Technological University (NTU), Singapore, working with Prof. Anupam Chattopadhyay (Fellow of TWAS and IEEE Senior Member).
        </p>
        <p>
          My research interests focus on cutting-edge areas including searchable encryption, privacy-preserving computation, and distributed machine learning security. I have published over 15 high-quality papers in prestigious international journals and conferences, including more than 10 papers in IEEE Transactions (such as IEEE TIFS, IEEE TDSC, IEEE TSC, IEEE TCE, IEEE TCC, IEEE TCNS, and IEEE TNSE), with over 10 of them as the first or corresponding author. Additionally, I have applied for more than 6 national invention patents. I have served as a Guest Editor for the international journal CMC-Computers, Materials &amp; Continua, and actively serve as a regular reviewer for renowned journals including IEEE TIFS, IEEE TPDS, IEEE TDSC, IEEE TCC, IEEE TCE, IEEE TNSE, and NCAA.
        </p>
        <p>
          Furthermore, I served as the Principal Investigator (PI) for the Chongqing Graduate Scientific Research Innovation Project, and participated as a key contributor in several major research projects, including the National Key R&amp;D Program of China, the Key Program and General Program of the National Natural Science Foundation of China (NSFC), as well as million-RMB-level industry-sponsored projects.
        </p>
      </div>

      <div class="divider my-2"></div>

      <div class="text-xl py-2 text-slate-600 font-medium">Education</div>
      <div class="space-y-3 text-base">
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-1">
          <div>
            <strong>Chongqing University</strong>&ensp;—&ensp;Computer Science &amp; Technology (Ph.D.)
          </div>
          <span class="text-slate-600 shrink-0">2022.09 – 2026.06</span>
        </div>

        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-1">
          <div>
            <strong>Southwest University</strong>&ensp;—&ensp;Signal and Information Processing (M.S.)
          </div>
          <span class="text-slate-600 shrink-0">2019.09 – 2023.06</span>
        </div>
      </div>

      <div class="divider my-2"></div>

      <div class="text-xl py-2 text-slate-600 font-medium">Overseas Experience</div>
      <div class="space-y-3 text-base">
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-1">
          <div>
            <strong>Nanyang Technological University</strong>&ensp;—&ensp;Computer Science &amp; Technology (Visiting Scholar)
          </div>
          <span class="text-slate-600 shrink-0">2023.10 – 2025.01</span>
        </div>
      </div>

      <div class="divider my-2"></div>

      <div class="text-xl py-2 text-slate-600 font-medium">Employment</div>
      <div class="space-y-3 text-base">
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-1">
          <div>
            <strong>Guazi Used Cars</strong>&ensp;—&ensp;Backend Software Engineer
          </div>
          <span class="text-slate-600 shrink-0">2021.07 – 2022.08</span>
        </div>
      </div>

      <div class="divider my-2"></div>

      <div class="mt-5 flex flex-wrap justify-center md:justify-start gap-3">
        <a class="btn btn-sm md:btn-md" href="mailto:lilvmy@163.com" target="_blank">Contact Me</a>
        <a class="btn btn-sm md:btn-md btn-outline" href="https://github.com/lilvmy" target="_blank">GitHub</a>
        <a class="btn btn-sm md:btn-md btn-outline" href="https://scholar.google.com/citations?user=AndU888AAAAJ&hl=zh-CN" target="_blank">Google Scholar</a>
      </div>
    </div>
  </div>

  <div class="divider my-2"></div>

  <!-- Academic News (Auto NEW firework badge + scrollable container) -->
  <div class="mt-4">
    <div class="flex items-center justify-between mb-4">
      <div class="text-2xl font-bold">Academic News</div>
      <span class="text-sm text-slate-400">Scroll to view more</span>
    </div>

    <div class="custom-scrollbar max-h-[380px] overflow-y-auto rounded-2xl border border-slate-200/80 bg-white/75 p-4 shadow-xs">
      {[...newsList].reverse().map((item, index) => (
        <>
          <HorizontalCard
            title={item.title}
            img={item.img}
            desc={item.desc}
            url={item.url}
            badge={index === 0 ? "NEW" : undefined}
          />
          {index < newsList.length - 1 && <div class="divider my-1"></div>}
        </>
      ))}
    </div>
  </div>
</BaseLayout>
