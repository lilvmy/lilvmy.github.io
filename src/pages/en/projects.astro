---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
---

<BaseLayout title="Projects | Your Name" sideBarActiveItemID="projects">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Projects</div>
  </div>

  <HorizontalCard
    title="Project One Title"
    img="/post_img.webp"
    desc="Detailed overview of Project One, including architecture, tech stack, and impact."
    url="https://github.com/lilvmy"
    badge="NEW"
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="Project Two Title"
    img="/post_img.webp"
    desc="Overview of Project Two."
    url="https://github.com/lilvmy"
  />
</BaseLayout>
