---
const pathname = Astro.url.pathname;
const cleanPath = pathname !== "/" && pathname.endsWith("/") ? pathname.slice(0, -1) : pathname;
const isEn = cleanPath === "/en" || cleanPath.startsWith("/en/");

// 自动计算当前页面对应的中文与英文路径
const zhPath = isEn ? (cleanPath.replace(/^\/en/, "") || "/") : cleanPath;
const enPath = isEn ? cleanPath : (cleanPath === "/" ? "/en" : `/en${cleanPath}`);
---

<div class="inline-flex items-center rounded-full border border-slate-200 bg-white p-1 shadow-sm">
  <a
    href={zhPath}
    class:list={[
      "rounded-full px-3.5 py-1 text-sm font-medium transition-colors",
      !isEn ? "bg-blue-600 text-white shadow-sm" : "text-slate-600 hover:text-blue-600"
    ]}
  >
    中
  </a>
  <span class="mx-1 text-slate-300 select-none">/</span>
  <a
    href={enPath}
    class:list={[
      "rounded-full px-3 py-1 text-sm font-medium transition-colors",
      isEn ? "bg-blue-600 text-white shadow-sm" : "text-slate-600 hover:text-blue-600"
    ]}
  >
    EN
  </a>
</div>
