---
const pathname = Astro.url.pathname;
const cleanPath = pathname !== "/" && pathname.endsWith("/") ? pathname.slice(0, -1) : pathname;
const isEn = cleanPath === "/en" || cleanPath.startsWith("/en/");

const zhPath = isEn ? (cleanPath.replace(/^\/en/, "") || "/") : cleanPath;
const enPath = isEn ? cleanPath : (cleanPath === "/" ? "/en" : `/en${cleanPath}`);
---

<div class="inline-flex items-center rounded-full border border-slate-200/90 bg-white/90 p-1 shadow-xs">
  <a
    href={zhPath}
    style={!isEn ? "background-color: var(--theme-primary);" : ""}
    class:list={[
      "nav-dynamic-btn rounded-full px-3.5 py-1 text-sm font-medium",
      !isEn ? "text-white shadow-xs" : "text-slate-600 hover:bg-slate-100"
    ]}
  >
    中
  </a>
  <span class="mx-1 text-slate-300 select-none">/</span>
  <a
    href={enPath}
    style={isEn ? "background-color: var(--theme-primary);" : ""}
    class:list={[
      "nav-dynamic-btn rounded-full px-3 py-1 text-sm font-medium",
      isEn ? "text-white shadow-xs" : "text-slate-600 hover:bg-slate-100"
    ]}
  >
    EN
  </a>
</div>
