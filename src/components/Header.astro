---
import LangSwitch from "./LangSwitch.astro";
const { sideBarActiveItemID } = Astro.props;

const pathname = Astro.url.pathname;
const isEn = pathname === "/en" || pathname.startsWith("/en/");

const navItems = isEn
  ? [
      { id: "home", label: "About", href: "/en" },
      { id: "news", label: "News", href: "/en/news" },
      { id: "publications", label: "Publications", href: "/en/publications" },
      { id: "students", label: "Students", href: "/en/students" },
      { id: "projects", label: "Projects", href: "/en/projects" },
      { id: "honors", label: "Honors", href: "/en/honors" },
    ]
  : [
      { id: "home", label: "简介", href: "/" },
      { id: "news", label: "动态", href: "/news" },
      { id: "publications", label: "论文", href: "/publications" },
      { id: "students", label: "学生", href: "/students" },
      { id: "projects", label: "项目", href: "/projects" },
      { id: "honors", label: "荣誉", href: "/honors" },
    ];
---

<header class="sticky top-0 z-30 w-full bg-base-100/90 backdrop-blur border-b border-base-200 transition-all">
  <div class="max-w-[960px] mx-auto px-4 md:px-6 h-16 flex items-center justify-between">
    <!-- 手机端下拉菜单 -->
    <div class="dropdown md:hidden">
      <label tabindex="0" class="btn btn-ghost btn-circle" aria-label="Menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </label>
      <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[50] p-2 shadow-lg bg-base-100 rounded-box w-40 border border-base-200">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                "py-2 text-base",
                sideBarActiveItemID === item.id ? "text-blue-600 font-bold bg-base-200/60" : "text-slate-700"
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- 电脑端左侧占位，使中间导航居中 -->
    <div class="hidden md:block w-24"></div>

    <!-- 电脑端横向导航栏 -->
    <nav class="hidden md:flex items-center space-x-8">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "text-base transition-colors py-1",
            sideBarActiveItemID === item.id
              ? "text-blue-600 font-bold border-b-2 border-blue-600"
              : "text-slate-700 hover:text-blue-600 font-medium"
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- 右侧中英文切换胶囊 -->
    <div class="flex items-center">
      <LangSwitch />
    </div>
  </div>
</header>
